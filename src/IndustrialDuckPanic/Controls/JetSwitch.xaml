<UserControl x:Class="IndustrialDuckPanic.Controls.JetSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="True" ToolTip="Moves by itself: OFF when docked, ON in space, middle when the state is unknown">
    <!-- Fighter-jet toggle on a metal plate. Read-only: it moves by itself. -->
    <Border Width="66" Padding="0,10" CornerRadius="5" BorderBrush="#FF000000" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3A3D42" Offset="0" />
                <GradientStop Color="#FF24262A" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- screws -->
            <Ellipse Width="6" Height="6" Fill="#FF15171A" Stroke="#FF5B6068" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,-5,0,0" />
            <Ellipse Width="6" Height="6" Fill="#FF15171A" Stroke="#FF5B6068" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,5,0" />
            <Ellipse Width="6" Height="6" Fill="#FF15171A" Stroke="#FF5B6068" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,-5" />
            <Ellipse Width="6" Height="6" Fill="#FF15171A" Stroke="#FF5B6068" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,-5" />

            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="OffLabel" Text="OFF" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="#FF7A7F87" />
                <Grid Width="36" Height="112" Margin="0,6">
                    <Border CornerRadius="6" BorderBrush="#FF000000" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF0B0C0E" Offset="0" />
                                <GradientStop Color="#FF2A2D33" Offset="0.5" />
                                <GradientStop Color="#FF0B0C0E" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Width="7" Margin="0,12" CornerRadius="3" Background="#FF000000" />
                    <!-- tick marks -->
                    <Border Width="22" Height="1" Background="#55FFFFFF" VerticalAlignment="Center" />

                    <Canvas x:Name="LeverHost" Width="36" Height="112" ClipToBounds="False">
                        <Canvas.RenderTransform>
                            <TranslateTransform x:Name="LeverMove" />
                        </Canvas.RenderTransform>
                        <!-- lever stem (seen from above, leaning toward its side) -->
                        <Border x:Name="Stem" Canvas.Left="14.5" Canvas.Top="38" Width="7" Height="36" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF6B7078" Offset="0" />
                                    <GradientStop Color="#FFDFE3E8" Offset="0.5" />
                                    <GradientStop Color="#FF6B7078" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="Knob" Canvas.Left="6" Canvas.Top="44" Width="24" Height="24">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#FFF3F5F8" Offset="0" />
                                    <GradientStop Color="#FF9AA1AB" Offset="0.45" />
                                    <GradientStop Color="#FF4B5058" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="3" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
                <TextBlock x:Name="OnLabel" Text="ON" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="#FF7A7F87" />
                <Ellipse x:Name="Led" Width="13" Height="13" Margin="0,8,0,0" Stroke="#FF000000" StrokeThickness="1" Fill="#FF2A2C30">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="LedGlow" Color="White" BlurRadius="14" ShadowDepth="0" Opacity="0" />
                    </Ellipse.Effect>
                </Ellipse>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
