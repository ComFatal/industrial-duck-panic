<UserControl x:Class="IndustrialDuckPanic.Controls.PanicButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="250" Height="250">
    <Grid>
        <!-- outer metal bezel -->
        <Ellipse Width="240" Height="240">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FF1A1C1F" Offset="0.80" />
                    <GradientStop Color="#FF5B6068" Offset="0.86" />
                    <GradientStop Color="#FF23262A" Offset="0.93" />
                    <GradientStop Color="#FF6A6F78" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.7" />
            </Ellipse.Effect>
        </Ellipse>
        <!-- hazard ring -->
        <Ellipse Width="208" Height="208" Stroke="#FF111111" StrokeThickness="12" />
        <Ellipse Width="208" Height="208" Stroke="#FFF2C230" StrokeThickness="12" StrokeDashArray="1.026 1.026" Opacity="0.9" />
        <Ellipse Width="184" Height="184" Fill="#FF15171A" Stroke="#FF000000" StrokeThickness="2" />

        <!-- the dome -->
        <Button x:Name="Dome" Width="168" Height="168" Click="Dome_Click" Focusable="True" Cursor="Hand"
                AutomationProperties.Name="PANIC">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Ellipse x:Name="Shadow" Fill="#FF3A0004" Margin="0,5,0,-5" />
                        <Ellipse x:Name="Body">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.36,0.3" Center="0.45,0.42" RadiusX="0.62" RadiusY="0.62">
                                    <GradientStop Color="#FFFF7B7B" Offset="0" />
                                    <GradientStop Color="#FFE0262E" Offset="0.38" />
                                    <GradientStop Color="#FF8E0A12" Offset="0.8" />
                                    <GradientStop Color="#FF4E0207" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Margin="22,10,40,80" Opacity="0.35">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="PANIC" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="38" Foreground="#FFFFF3F3">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF5A0006" BlurRadius="0" ShadowDepth="2" Direction="270" Opacity="1" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <Ellipse x:Name="Dim" Fill="#B0141414" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Margin" Value="0,2,0,-2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Dim" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- radar sweep, plays after a press -->
        <Grid x:Name="Sweep" Width="168" Height="168" IsHitTestVisible="False" Opacity="0">
            <Grid.Clip>
                <EllipseGeometry Center="84,84" RadiusX="84" RadiusY="84" />
            </Grid.Clip>
            <!-- beam wedges are generated in code (fake conic gradient) -->
            <Canvas x:Name="SweepCanvas" Width="168" Height="168">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SweepRotate" CenterX="84" CenterY="84" />
                </Canvas.RenderTransform>
            </Canvas>
            <Ellipse Stroke="#FFF0A020" StrokeThickness="3" />
        </Grid>

        <!-- glass safety cover, hinged on the left: opens from right to left -->
        <Border x:Name="Glass" Width="244" Height="244" CornerRadius="14" BorderBrush="#73FFFFFF" BorderThickness="1.5"
                RenderTransformOrigin="0,0.5" Cursor="Hand" MouseLeftButtonUp="Glass_Click" Focusable="True" KeyUp="Glass_KeyUp"
                ToolTip="Lift the cover">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#0BFFFFFF" Offset="0.3" />
                    <GradientStop Color="#05FFFFFF" Offset="0.55" />
                    <GradientStop Color="#26FFFFFF" Offset="0.7" />
                    <GradientStop Color="#08FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="GlassScale" />
                    <SkewTransform x:Name="GlassSkew" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <!-- hinge -->
                <Border Width="7" Margin="-4,40" HorizontalAlignment="Left" CornerRadius="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF6B7078" Offset="0" />
                            <GradientStop Color="#FFDFE3E8" Offset="0.5" />
                            <GradientStop Color="#FF6B7078" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- grip -->
                <Border Width="9" Height="44" Margin="0,0,-5,0" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="3">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFC9CED6" Offset="0" />
                            <GradientStop Color="#FF6B7078" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border Margin="0,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#99000000" CornerRadius="3" Padding="6,2">
                    <TextBlock x:Name="GlassLabel" Text="LIFT COVER" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#CCFFFFFF" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
