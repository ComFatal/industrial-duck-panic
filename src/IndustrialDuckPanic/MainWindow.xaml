<Window x:Class="IndustrialDuckPanic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:IndustrialDuckPanic.Controls"
        xmlns:p="clr-namespace:IndustrialDuckPanic.Panels"
        xmlns:vm="clr-namespace:IndustrialDuckPanic.ViewModels"
        Title="Industrial Duck Panic" Icon="Assets/app.ico"
        Width="430" Height="720" MinWidth="340" MinHeight="560"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:InverseBoolToVisibility x:Key="NotBoolToVis" />
        <c:HealthToBrush x:Key="HealthBrush" />
        <c:NullToCollapsed x:Key="NullToCollapsed" />
        <c:InverseBool x:Key="NotBool" />
    </Window.Resources>

    <Grid>
        <!-- background: radial glow + faint grid -->
        <Border Background="{StaticResource WindowBackground}" />
        <Border Background="{StaticResource GridBrush}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Height="40">
                <DockPanel LastChildFill="False" Margin="4,0">
                    <ToggleButton x:Name="TabCharacter" DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Character" Click="Tab_Click" Tag="character" />
                    <ToggleButton x:Name="TabDiscord" DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Discord" Click="Tab_Click" Tag="discord" IsEnabled="{Binding IsConnected}" />
                    <ToggleButton x:Name="TabUsage" DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Usage" Click="Tab_Click" Tag="usage" IsEnabled="{Binding IsConnected}" />
                    <ToggleButton x:Name="TabLegal" DockPanel.Dock="Left" Style="{StaticResource TabButton}" Content="Legal" Click="Tab_Click" Tag="legal" />
                    <ToggleButton x:Name="TabStatus" DockPanel.Dock="Right" Style="{StaticResource TabButton}" Click="Tab_Click" Tag="status" IsEnabled="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status" VerticalAlignment="Center" />
                            <Ellipse Width="16" Height="10" Margin="7,0,0,0" VerticalAlignment="Center" Fill="{Binding OverallHealth, Converter={StaticResource HealthBrush}}">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{Binding OverallHealth, Converter={StaticResource HealthBrush}, ConverterParameter=color}" BlurRadius="8" ShadowDepth="0" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </StackPanel>
                    </ToggleButton>
                </DockPanel>
            </Border>

            <!-- ============ main screen ============ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TACKLED -->
                <StackPanel Grid.Row="0" Margin="14,16,14,0">
                    <c:TackledBar IsActive="{Binding IsTackled}" />
                    <Grid Height="22" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TackleText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsTackled, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,70,0" />
                        <Button Content="Silence" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Silence_Click"
                                Visibility="{Binding IsTackled, Converter={StaticResource BoolToVis}}" ToolTip="Stop the blinking light. No message is sent." />
                    </Grid>
                </StackPanel>

                <!-- PANIC + switch -->
                <Grid Grid.Row="1" Margin="14,4,14,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Stretch="Uniform" MaxWidth="330" MaxHeight="330" Margin="0,0,8,0">
                        <c:PanicButton x:Name="Panic" IsArmed="{Binding IsRorqual}" Pressed="Panic_Pressed" Margin="6" />
                    </Viewbox>
                    <c:JetSwitch Grid.Column="1" VerticalAlignment="Center" Position="{Binding Switch}" />
                </Grid>

                <!-- I'M OK -->
                <Button Grid.Row="2" Margin="14,6,14,10" Height="44" HorizontalAlignment="Stretch" MaxWidth="320" Click="ImOk_Click" Cursor="Hand"
                        IsEnabled="{Binding CanImOk}" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Tell Discord you are alive and safe (allowed ships only)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="B" CornerRadius="3" BorderBrush="#FF2ECC71" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop x:Name="G1" Color="#FF1F7A45" Offset="0" />
                                        <GradientStop Color="#FF135230" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="I'M OK" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="#FFE9FFF1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="B" Property="BorderBrush" Value="#FF7CF0A8" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="B" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="1" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="B" Property="Opacity" Value="0.3" />
                                    <Setter TargetName="B" Property="BorderBrush" Value="#FF4A3F2E" />
                                    <Setter Property="Cursor" Value="No" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- footer: ship / system -->
                <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource DimBrush}">
                            <Run Text="Ship   " /><Run Text="{Binding ShipTypeName, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Row="0" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource DimBrush}" Text="{Binding CharacterName}" />
                        <TextBlock Grid.Row="1" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource DimBrush}">
                            <Run Text="System " /><Run Text="{Binding SystemName, Mode=OneWay}" Foreground="{StaticResource TextBrush}" /><Run Text=" " /><Run Text="{Binding SecurityText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource DimBrush}" Text="{Binding LocationText}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4,0,0" Text="{Binding Toast}" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- red bars: wrong ship / ship lost -->
                <StackPanel Grid.Row="4">
                    <Border Background="{StaticResource HazardRedBrush}" BorderBrush="#FFFF4A52" BorderThickness="0,1,0,0" Padding="8,10"
                            Visibility="{Binding ShowShipError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ERROR, NOT IN ALLOWED SHIP LIST" HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="White" />
                    </Border>
                    <Border Background="{StaticResource HazardRedBrush}" BorderBrush="#FFFF4A52" BorderThickness="0,1,0,0" Padding="8,10"
                            Visibility="{Binding ShowShipLost, Converter={StaticResource BoolToVis}}">
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="White">
                            <Run Text="SHIP LOST · " /><Run Text="{Binding ShipLostText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- ============ gate: nothing works without a character ============ -->
                <Border Grid.Row="0" Grid.RowSpan="5" Background="#E6100F0D" Visibility="{Binding IsConnected, Converter={StaticResource NotBoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
                        <Image Source="Assets/ore-logo.png" Width="170" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Connect your character" Style="{StaticResource H1}" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,18"
                                   Text="Industrial Duck Panic needs your EVE character to know your ship, your system and when you undock." />
                        <Button HorizontalAlignment="Center" Click="Login_Click" Cursor="Hand" IsEnabled="{Binding IsLoggingIn, Converter={StaticResource NotBool}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="B" Background="#FF000000" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="2" Padding="18,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="LOG IN with " FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="#FFCCCCCC" VerticalAlignment="Bottom" />
                                            <TextBlock Text="EVE ONLINE" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="White" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="B" Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Text="Finish the login in your browser…" />
                            <Button Content="Cancel" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Click="CancelLogin_Click" />
                        </StackPanel>
                        <TextBlock Text="{Binding Toast}" Style="{StaticResource Muted}" Foreground="#FFFF6B6B" TextAlignment="Center" Margin="0,12,0,0"
                                   Visibility="{Binding Toast, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </Border>

                <!-- ============ panels (Character / Discord / Usage / Legal / Status) ============ -->
                <Border x:Name="PanelHost" Grid.Row="0" Grid.RowSpan="5" Background="#F2121110" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="16,12,10,4">
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" FontSize="16" Click="ClosePanel_Click" ToolTip="Close (Esc)" />
                            <TextBlock x:Name="PanelTitle" Style="{StaticResource H1}" Margin="0" />
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,6,16,16">
                            <ContentControl x:Name="PanelContent" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
