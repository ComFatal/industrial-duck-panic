<UserControl x:Class="IndustrialDuckPanic.Panels.DiscordPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IndustrialDuckPanic.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:HealthToBrush x:Key="HealthBrush" />
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </UserControl.Resources>
    <StackPanel>

        <!-- active configuration -->
        <Border Style="{StaticResource Section}">
            <StackPanel>
                <DockPanel>
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding WebhookHealth, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Text="Active configuration" Style="{StaticResource H2}" Margin="0" />
                </DockPanel>
                <TextBlock Text="{Binding ConfigSummary}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding WebhookDetail}" Style="{StaticResource Muted}" />
                <Button Content="Send test message" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Test_Click"
                        IsEnabled="{Binding HasConfig}" />
            </StackPanel>
        </Border>

        <!-- create -->
        <Border Style="{StaticResource Section}">
            <StackPanel>
                <TextBlock Text="Webhook configuration" Style="{StaticResource H2}" Margin="0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="For the person who owns the Discord channel. In Discord: channel settings → Integrations → Webhooks → New webhook → Copy webhook URL. Paste it below." />

                <TextBlock Text="Webhook URL" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="WebhookUrlBox" ToolTip="The URL is encrypted in IDP.config and never shown again." />

                <TextBlock Text="Messages" Style="{StaticResource FieldLabel}" />
                <TextBlock Style="{StaticResource Muted}" Text="You can use %personnage_name%, %system%, %ship% and %attacker% (tackled only)." Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Test" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="MsgTest" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="Tackled" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="MsgTackled" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Panic" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="MsgPanic" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="Destroyed" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="MsgDestroyed" Margin="0,2" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="I'm OK" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="MsgOk" Margin="0,2" TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="Ping" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PingModeBox" SelectionChanged="PingMode_Changed">
                        <ComboBoxItem Content="No ping" Tag="None" />
                        <ComboBoxItem Content="@here" Tag="Here" />
                        <ComboBoxItem Content="@everyone" Tag="Everyone" />
                        <ComboBoxItem Content="A Discord role" Tag="Role" />
                    </ComboBox>
                </Grid>
                <StackPanel x:Name="RoleRow" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,4" Text="Role id: in Discord, turn on Developer Mode, then right-click the role → Copy Role ID." />
                    <TextBox x:Name="RoleId" />
                </StackPanel>

                <TextBlock Text="Alliance / Corporation" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="Owner" DisplayMemberPath="Label" ItemsSource="{Binding OwnerChoices}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Only members of this corporation or alliance can load the file." />

                <TextBlock x:Name="CreateResult" Style="{StaticResource Body}" Margin="0,12,0,0" Visibility="Collapsed" />

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="SAVE" Style="{StaticResource PrimaryButton}" Width="110" Click="Save_Click" />
                    <Button DockPanel.Dock="Right" Content="CANCEL" Style="{StaticResource ActionButton}" Width="110" Click="Cancel_Click" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- share -->
        <Border Style="{StaticResource Section}">
            <StackPanel>
                <TextBlock Text="Share configuration" Style="{StaticResource H2}" Margin="0" />
                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                           Text="SAVE creates a file named IDP.config. This is the file to share with the members of your corporation or alliance, for example in a pinned Discord message. Each member opens Discord → Load configuration and picks it." />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                           Text="The webhook URL inside the file is encrypted: members can use it from the app but cannot read it or copy it elsewhere. Editing the file by hand breaks it." />
            </StackPanel>
        </Border>

        <!-- load -->
        <Border Style="{StaticResource Section}">
            <StackPanel>
                <TextBlock Text="Load configuration" Style="{StaticResource H2}" Margin="0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Pick the IDP.config file given by your corporation or alliance. The app checks the file and that your character belongs to the right group." />
                <Button Content="Load IDP.config…" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="Load_Click" />
                <TextBlock x:Name="LoadResult" Style="{StaticResource Body}" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
